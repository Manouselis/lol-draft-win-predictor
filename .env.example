# Obtain your own key at https://developer.riotgames.com/ . NEVER put it in frontend code.
RIOT_API_KEY=
# Defaults are EUW ranked solo/duo, recent matches ONLY.
LOL_REGION=EUW1
LOL_QUEUE=420
LOL_TARGET_MATCHES=100000
# Production readiness floor. This does not guarantee accuracy; inspect held-out metrics.
LOL_MIN_MATCHES=50000
# No training/import/collection on matches older than 30 days is supported.
LOL_DATA_DIR=data
# Read-only integration is off until Riot reviews this specific live probability use case.
LOL_LCU_ENABLED=false
LOL_RIOT_LIVE_APPROVED=false
# Optional explicit League install directory, never a credential or process command line.
LOL_LCU_DIRECTORY=C:\Riot Games\League of Legends
# Loopback client uses a self-signed cert; optionally set an appropriate CA certificate.
LOL_LCU_CA_FILE=
